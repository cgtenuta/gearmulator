.multiStripeAlt
{
	background-color: rgba(255,255,255,20);
}
.txtMultiHdr
{
	background-color: rgb(72,72,72);
	border-radius: 6dp;
	color: #ffffff;
	font-family: Koshgarian;
	font-size: 26dp;
	text-align: center;
}
.txtMultiLbl
{
	color: #1a1a1a;
	font-family: Koshgarian;
	font-size: 16dp;
	text-align: center;
	text-transform: uppercase;
}
.txtMultiCombo
{
	color: #ffffff;
	font-size: 16dp;
	text-align: center;
	padding: 0dp 42dp 0dp 3dp;
}
.combo_multi
{
	decorator: image(combo_multi.png scale-none left top);
